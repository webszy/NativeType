{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "nativetype-api",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  // Bindings match apps/web/wrangler.jsonc. This file exists so tests load the Worker entry.
  "vars": {
    "PRODUCTION_ID": "emicomnfbabkhcpphlihhbddhlmkdhfk",
    "DEV_ID": "eoiplhjpakggmbahkkkcaacdcbdfklbf"
  },
  "secrets": {
    "required": ["ANALYTICS_HMAC_SECRET"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nativetype-analytics",
      "database_id": "6080527d-a65a-44de-a308-c8eed695fb32",
      "migrations_dir": "../migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "ANALYTICS_RATE_LIMITER",
      "namespace_id": "10001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
