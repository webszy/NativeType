{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nativetype-api",
  "account_id": "d44223ee73c4210abdaf28c3a7dcffe6",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  // Same Worker as the former API: the next deploy keeps the secret and D1 binding.
  // Nitro's cloudflare_module preset fills `main` and `assets` in the generated deploy config.
  // The only custom domain is typewith.si. API paths are https://typewith.si/api/v1/*.
  // Do not attach api.typewith.si. Do not delete the D1 database.
  "workers_dev": true,
  "routes": [
    {
      "pattern": "typewith.si",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  // The Worker composes ALLOWED_ORIGINS from these two extension IDs.
  // .dev.vars can override each ID locally; no variable expansion is required.
  "vars": {
    "PRODUCTION_ID": "emicomnfbabkhcpphlihhbddhlmkdhfk",
    "DEV_ID": "eoiplhjpakggmbahkkkcaacdcbdfklbf"
  },
  "secrets": {
    "required": ["ANALYTICS_HMAC_SECRET"]
  },
  // Pin the production database so deploys and migrations target this resource.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nativetype-analytics",
      "database_id": "6080527d-a65a-44de-a308-c8eed695fb32",
      "migrations_dir": "migrations"
    }
  ],
  // namespace_id is chosen by us and must be unique in the Cloudflare account.
  // The limit is enforced inside one Cloudflare location and can be exceeded globally.
  "ratelimits": [
    {
      "name": "ANALYTICS_RATE_LIMITER",
      "namespace_id": "10001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  // Once per day, after the UTC date has rolled. Not a high-frequency schedule.
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
