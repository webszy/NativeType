{
  "name": "nativetype",
  "description": "Write in your language. Publish in another.",
  "private": true,
  "version": "0.0.4",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm dev:extension",
    "dev:extension": "pnpm --filter @nativetype/extension dev",
    "dev:web": "pnpm --filter @nativetype/web dev",
    "build": "pnpm build:extension",
    "build:extension": "pnpm --filter @nativetype/extension build",
    "build:web": "pnpm --filter @nativetype/web build",
    "test:extension": "pnpm --filter @nativetype/extension test",
    "test:web": "pnpm --filter @nativetype/web test",
    "typecheck": "pnpm --filter @nativetype/extension --filter @nativetype/contracts --filter @nativetype/web typecheck",
    "db:migrate:web:local": "pnpm --filter @nativetype/web db:migrate:local",
    "db:migrate:web:remote": "pnpm --filter @nativetype/web db:migrate:remote",
    "deploy:web": "pnpm --filter @nativetype/web deploy",
    "zip": "pnpm --filter @nativetype/extension zip",
    "compile": "pnpm --filter @nativetype/extension compile",
    "screenshot:store": "pnpm --filter @nativetype/extension screenshot:store"
  }
}
