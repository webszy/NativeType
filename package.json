{
  "name": "nativetype",
  "description": "Write in your language. Publish in another.",
  "private": true,
  "version": "0.0.4",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm dev:extension",
    "dev:extension": "pnpm --filter @nativetype/extension dev",
    "dev:api": "pnpm --filter @nativetype/api dev",
    "build": "pnpm build:extension",
    "build:extension": "pnpm --filter @nativetype/extension build",
    "build:api": "pnpm --filter @nativetype/api build",
    "test:extension": "pnpm --filter @nativetype/extension test",
    "test:api": "pnpm --filter @nativetype/api test",
    "typecheck": "pnpm --filter @nativetype/extension --filter @nativetype/contracts --filter @nativetype/api typecheck",
    "db:migrate:api:local": "pnpm --filter @nativetype/api db:migrate:local",
    "db:migrate:api:remote": "pnpm --filter @nativetype/api db:migrate:remote",
    "deploy:api": "pnpm --filter @nativetype/api deploy",
    "zip": "pnpm --filter @nativetype/extension zip",
    "compile": "pnpm --filter @nativetype/extension compile",
    "screenshot:store": "pnpm --filter @nativetype/extension screenshot:store"
  }
}
